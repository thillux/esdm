%YAML 1.2
---
# strongswan.conf(5): sections in braces, key = value settings, # comments.
name: strongSwan
file_extensions: [strongswan]
scope: source.strongswan

contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.strongswan
    - match: '^\s*(include)\s+(.*)$'
      captures:
        1: keyword.control.import.strongswan
        2: string.unquoted.strongswan
    - match: '([A-Za-z0-9_.-]+)\s*(?=\{)'
      captures:
        1: entity.name.section.strongswan
    - match: '([A-Za-z0-9_.-]+)\s*(=)'
      captures:
        1: variable.other.key.strongswan
        2: keyword.operator.assignment.strongswan
      push: value
    - match: '[{}]'
      scope: punctuation.section.block.strongswan

  value:
    - match: '(?=#)|$'
      pop: true
    - match: '[^#\s]+(\s+[^#\s]+)*'
      scope: string.unquoted.value.strongswan
