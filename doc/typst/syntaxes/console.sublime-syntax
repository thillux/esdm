%YAML 1.2
---
# A shell session: commands after the prompt "$ ", continued by a trailing
# backslash, and the output between them. Self-contained, as a syntax Typst
# loads cannot embed one it ships.
name: Console
file_extensions: [console]
scope: text.console

contexts:
  main:
    - match: '^(\$)\s'
      captures:
        1: punctuation.definition.prompt.console
      push: command-start
    - match: '^.*$'
      scope: meta.output.console

  # Before the command name: variable assignments, then the name.
  command-start:
    - meta_scope: meta.command.console
    - match: '$'
      pop: true
    - match: '([A-Za-z_][A-Za-z0-9_]*)(=)([^\s]*)'
      captures:
        1: variable.other.key.console
        2: keyword.operator.assignment.console
        3: string.unquoted.console
    - match: '[A-Za-z0-9_./+-]+'
      scope: entity.name.function.command.console
      set: command

  command:
    - meta_scope: meta.command.console
    - match: '\\$'
      scope: punctuation.separator.continuation.console
      set: continued
    - match: '$'
      pop: true
    - match: '\|\|?|&&|;'
      scope: keyword.operator.console
      set: command-start
    - include: shell

  continued:
    - meta_scope: meta.command.console
    - match: '^'
      set: command

  shell:
    - match: '(\s)(#.*)$'
      captures:
        2: comment.line.number-sign.console
    - match: "'"
      push:
        - meta_scope: string.quoted.single.console
        - match: "'"
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.console
        - match: '\\.'
          scope: constant.character.escape.console
        - match: '"'
          pop: true
    - match: '\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*'
      scope: variable.other.console
    - match: '(\s)(--?[A-Za-z0-9][A-Za-z0-9_-]*)'
      captures:
        2: variable.parameter.option.console
    - match: '[0-9]?>>?(&[0-9])?|<'
      scope: keyword.operator.redirect.console
