// Chapter 5: NTG.1 of the prediction resistance path with the Jitter RNG in
// its NTG.1 mode: the internal conditioning of the Jitter RNG, then the ESDM
// as a further, external conditioning stage. The labels name the NTG.1
// requirements each stage meets.
digraph ntg1 {
  graph [rankdir=TB, nodesep=0.25, ranksep=0.35, fontname="Source Sans 3",
         bgcolor="#FFFFFF"];
  node [shape=box, style="rounded,filled", fontname="Source Sans 3",
        fontsize=10, color="#334155", fillcolor="#FFFFFF",
        fontcolor="#0F172A", margin="0.12,0.05"];
  edge [color="#475569", arrowsize=0.6, fontname="Source Sans 3",
        fontsize=9, fontcolor="#475569"];

  subgraph cluster_jent {
    label="Jitter RNG with JENT_NTG1: an NTG.1 RNG by itself"; fontsize=10;
    style="rounded,filled"; color="#CBD5E1"; fillcolor="#F1F5F9";
    mem [label="Noise source 1\nmemory access timing"];
    sha [label="Noise source 2\nSHA-3 hash loop timing"];
    {rank=same; mem; sha;}
    ht [label="Health tests on every time delta: RCT, APT,\nRCT with memory, lag predictor (NTG.1.1)\nstart-up: each noise source alone (NTG.1.4)"];
    cond [label="Internal conditioning: SHAKE-256 into an XDRBG-256\n(256 + 65) · OSR time deltas per 256-bit block\n(NTG.1.2, NTG.1.3, NTG.1.5)"];
    mem -> ht; sha -> ht; ht -> cond;
  }

  subgraph cluster_esdm {
    label="ESDM prediction resistance path: external conditioning"; fontsize=10;
    style="rounded,filled"; color="#CBD5E1"; fillcolor="#F1F5F9";
    seed [label="Reseed of the prediction resistance DRNG\n256 + 64 = 320 credited bits", fillcolor="#DBEAFE"];
    gen [label="Generate with a DRG.3 DRNG (NTG.1.3)\nchunk ≤ credited bits − 64, ≤ 256 bits\n(NTG.1.2, NTG.1.5)", fillcolor="#DBEAFE"];
    seed -> gen;
  }

  out [label="NTG.1 output\nRPC _pr, GRND_RANDOM, /dev/esdm_pr,\nO_SYNC, EGD prediction resistance socket",
       fillcolor="#2563EB", fontcolor="#FFFFFF"];

  cond -> seed [label=" 320 bits, credited at\n es_jent_entropy_rate"];
  gen -> out;
}
