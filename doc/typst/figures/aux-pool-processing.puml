@startuml
' Figure: Auxiliary Pool Processing
' The auxiliary pool is an XDRBG-256 (esdm/crypto/esdm_xdrbg.c,
' esdm/esdm_es_aux.c); user space inserts three buffers. The colours of the
' seed buffer are those of figure big-picture.
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontColor #0F172A
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #475569
skinparam ActivityBorderColor #334155
skinparam ActivityBackgroundColor #DBEAFE
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #334155
skinparam NoteBackgroundColor #DBEAFE
skinparam NoteBorderColor #334155

:ESDM lib start; <<#FFFFFF>>
:SHAKE256 Init;
note left #FFFFFF: Auxiliary Pool (XDRBG-256)
repeat
  :Absorb D;
  note right
    User Space
    Writes
    IOCTL
  end note
  :Absorb D;
  note right
    User Space
    Writes
    IOCTL
  end note
  -[dotted]-> ...;
  :Absorb D;
  note right
    User Space
    Writes
    IOCTL
  end note
  :Absorb encode(alpha, 1)
  (encode(alpha, 0) at the first extraction);
  :V = SHAKE256 Final (512 bits);
  :SHAKE256 Init, absorb V, encode(alpha, 2);
  :V' || A = SHAKE256 Final (512 bits + |A|);
  note right #FFFFFF
    A to the seed buffer
    |<#E9C08F>   |<#E9C08F>   |<#F8E1C3>   |<#F8E1C3>   |<#F1F5F9>   |<#F1F5F9>   |<#F1F5F9>   |<#F1F5F9>   |<#F1F5F9>   |<#F1F5F9>   |<#F1F5F9>   |<#DBEAFE>   |<#94A3B8> |
  end note
  :SHAKE256 Init, absorb V';
repeat while (...)
detach
@enduml
