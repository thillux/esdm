@startuml
' Figure 2.5: Collection Pool Processing
' Life cycle of the per-CPU entropy pool (a hash state) of the interrupt ES:
' filled collection pools are hashed in, the digest goes into the seed
' buffer next to the digests of the other CPUs.
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #000000
skinparam ActivityBorderColor #000000
skinparam ActivityBackgroundColor #FFB66C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000

:Kernel Start; <<#FFFFFF>>
:Hash Init;
note left: Entropy Pool
repeat
  :Hash Update;
  note right
    Filled Collection Pool Instances
    |<#FFB66C>| |<#FFB66C>| |<#FFB66C>| |<#FFB66C>      ...      |<#FFB66C>| |<#FFB66C>| |<#FFB66C>| |
  end note
  :Hash Update;
  note right
    |<#FFB66C>| |<#FFB66C>| |<#FFB66C>| |<#FFB66C>      ...      |<#FFB66C>| |<#FFB66C>| |<#FFB66C>| |
  end note
  -[dotted]-> ...;
  :Hash Update;
  note right
    |<#FFB66C>| |<#FFB66C>| |<#FFB66C>| |<#FFB66C>      ...      |<#FFB66C>| |<#FFB66C>| |<#FFB66C>| |
  end note
  :Hash Final;
  :Hash Init;
  note right
    |<#FFB66C> Digest CPU0 | CPU 0 |
     
    |<#66FFFF>   |<#FFB66C>   |<#AFD095>   |<#FFFFA6>   |<#FF4000>   |<#6B5E9B>   |<#EC9BA4>   |<#E8F2A1> |
     
    |<#FFB66C> Digest CPU1 | CPU 1 |
    |<#FFB66C> Digest CPUn | CPU n |
  end note
  :Hash Update;
repeat while (...)
detach
@enduml
