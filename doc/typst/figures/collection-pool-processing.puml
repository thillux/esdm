@startuml
' Figure: Kernel Entropy Source Data Extraction
' esdm_es_drbg_pool_extract() / esdm_es_drbg_pool_extract_block() of
' kernel/esdm_es/esdm_es_drbg.c, serving the ESDM_IRQ_ENT_BUF and
' ESDM_SCHED_ENT_BUF IOCTLs of /dev/esdm_es
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontColor #0F172A
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #475569
skinparam ActivityBorderColor #334155
skinparam ActivityBackgroundColor #E9C08F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #334155
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #334155

start
:ESDM_IRQ_ENT_BUF / ESDM_SCHED_ENT_BUF
IOCTL of /dev/esdm_es
(b requested bits: 256, 320 or 384); <<#FFFFFF>>
if (SP800-90B startup test completed\nand high-resolution timer?) then (no)
  :Return no data;
  stop
else (yes)
endif
if (Recorded events suffice for\nall ceil(b / 256) blocks?) then (no)
  :Return no data;
  stop
else (yes)
endif
repeat
  :Collect ceil((256 + o) * r / 256) timestamps
  from the per-CPU rings;
  note right
    |<#E9C08F>| |<#E9C08F>| |<#E9C08F>| |<#E9C08F>      ...      |<#E9C08F>| |<#E9C08F>| |<#E9C08F>| |
    CPU 0 ... CPU N rings
    r: timestamps per 256 bits of entropy
    o: 65 bits oversampling in FIPS mode
    (129 bits before the DRBG is instantiated)
  end note
  :DRBG.Seed(timestamps)
  (instantiate, then reseed);
  :Block = DRBG.Generate(up to 256 bits,
  additional input "ESDM_IRQ_DRBG"
  or "ESDM_SCH_DRBG");
  :Release the ring slots;
repeat while (More blocks needed?) is (yes)
-> no;
if (Rings reset during the extraction?) then (yes)
  :Zeroize and return no data;
else (no)
  :Return b bits of the blocks
  credited with b bits of entropy; <<#FFFFFF>>
endif
stop
@enduml
