// Chapter 2: the states of one DRNG instance other than the prediction
// resistance instance (struct esdm_drng).
digraph drng {
  graph [rankdir=TB, nodesep=0.55, ranksep=0.5, fontname="Source Sans 3",
         bgcolor="#FFFFFF"];
  node [shape=box, style="rounded,filled", fontname="Source Sans 3",
        fontsize=13, color="#334155", fillcolor="#FFFFFF",
        fontcolor="#0F172A", margin="0.14,0.06"];
  edge [color="#475569", arrowsize=0.6, fontname="Source Sans 3",
        fontsize=11, fontcolor="#475569"];
  start [shape=point, width=0.12, color="#0F172A", fillcolor="#0F172A"];
  unalloc [label="Not allocated", fillcolor="#F1F5F9"];
  unseeded [label="Not fully seeded\nserves nothing"];
  fresh [label="Fully seeded\nserves requests", fillcolor="#DBEAFE"];
  due [label="Fully seeded, reseed due\nserves, reseeds first", fillcolor="#DBEAFE"];
  spent [label="Fully seeded, budget spent\n(node DRNG, worker running)\nserves nothing", fillcolor="#DBEAFE"];

  start -> unalloc;
  unalloc -> unseeded [label="allocation"];
  unseeded -> unseeded [label="seed below\nthe full level"];
  unseeded -> fresh [label="seed reaches\nthe full level"];
  fresh -> due [label="2^20 generates, 600 s,\nbit threshold, forced"];
  due -> fresh [label="reseed with\nfull entropy"];
  due -> due [label="reseed with\nthe time only"];
  fresh -> spent [label="output budget\nused up"];
  spent -> fresh [label="worker reseeds"];
  due -> unseeded [label="2^30 generates or\nmaximum bits without\na full reseed", style=dashed, color="#B91C1C", fontcolor="#B91C1C"];
  fresh -> unseeded [label="esdm_reset,\nfork (child)", style=dashed, color="#B91C1C", fontcolor="#B91C1C"];
  unseeded -> unalloc [label="esdm_fini"];
}
