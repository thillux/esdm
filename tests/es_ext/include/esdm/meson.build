# esdm_es_ext.h where the ESDM installs it, so that the example of
# es-ext/example includes it in the tree as it does when built on its own:
# <esdm/esdm_es_ext.h> below the include directory of pkg-config.
configure_file(input: '../../../../es-ext/esdm_es_ext.h',
	output: 'esdm_es_ext.h',
	copy: true)
