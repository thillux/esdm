 .kdev4
*.kdev4

# meson / build artifacts
/build/
/build-fuzz/
/builddir/

# core dumps - the fuzz harnesses abort on a finding by design
core.*

# nix build results
/result
/result-*
result
result-*
/kernel/esdm_es/result
/kernel/esdm_es/result-*

# caches and local test state
/.cache/
/.nixos-test-history

# stray test output
/out.bin

# default output of esdm-coverage-run
/esdm-coverage-report/

# byte code of the raw measurement analysis helpers
__pycache__/

# generated by doc/typst/Makefile: the figures rendered from their draw.io
# and PlantUML sources, the documents and the trees make diff compares
/doc/typst/figures/*.svg
/doc/typst/*.pdf
/doc/typst/*.pdf.log
/doc/typst/build/
